# Copy this file to .env and fill it in. Never commit .env (it is git-ignored).

# Which model reads the documents: gemini (free tier) or anthropic (paid)
LLM_PROVIDER=gemini

# Free key: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=

# Model names change often. Let the project choose models that are answering right now:
#   python -m app.check_models --apply
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=

# 1 = save each document reading on disk so repeat runs are instant and free (good for development)
# 0 = always call the model (use this for live demos)
EXTRACTION_CACHE=0

# Optional limits for a public deployment
# RUNS_PER_HOUR=40
# MAX_CONCURRENT_RUNS=3
# MAX_UPLOAD_MB=8
